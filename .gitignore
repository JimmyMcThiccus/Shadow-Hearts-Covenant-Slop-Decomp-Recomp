# build output
/port/HOME/
target/
# screenshots / captures (large, regenerated)
/notes/integration/screens/
*.png
# memory dumps / pickles
*.pkl
tools/live/*.bin
notes/integration/pine_dumps/
# locks + logs + mac junk
/notes/integration/locks/
*.log
._*
.DS_Store
__pycache__/

# game binaries extracted from the discs (stay on disk, never committed)
/overlays/*.BIN
*.ELF

# audio rendered from the discs (regenerate with the cs2_chr_se example, `--wav DIR`)
*.wav
# per-machine cargo config (target-dir points at a local cache)
/port/.cargo/config.toml
# stray build output / backups
/warn.txt
*.bak
# the user's own disc images, dropped next to the launch scripts / sh2_app.exe (never committed)
*.iso
*.ISO
